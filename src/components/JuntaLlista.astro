---
import { toRomanOrdinal } from '../lib/roman-ordinal';
import { mediaUrl } from '../lib/media';

interface Membre {
  carrec: string;
  nom: string;
  cognom: string;
  malnom?: string;
  foto?: string;
}
interface Temporada {
  numeroTemporada: number;
  membres: Membre[];
}
interface Props {
  temporades: Temporada[];
}

const { temporades } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<div class="junta-llista">
  {temporades.map((t, i) => (
    <details class="temporada" open={i === 0}>
      <summary>
        <span class="numero display">{toRomanOrdinal(t.numeroTemporada)}</span>
        <span class="comptador">{t.membres.length} {t.membres.length === 1 ? 'persona' : 'persones'}</span>
      </summary>
      <div class="membres">
        {t.membres.map((m) => {
          const foto = mediaUrl(base, m.foto);
          return (
            <div class={`persona${foto ? '' : ' sense-foto'}`}>
              {foto && <img class="foto" src={foto} alt="" width="200" height="200" loading="lazy" />}
              <div class="nom">{m.nom} {m.cognom}</div>
              {m.malnom && <div class="malnom">{m.malnom}</div>}
              <div class="carrec">{m.carrec}</div>
            </div>
          );
        })}
        {t.membres.length === 0 && <p class="empty">Encara no hi ha càrrecs assignats aquesta temporada.</p>}
      </div>
    </details>
  ))}
  {temporades.length === 0 && <p class="empty">Encara no hi ha temporades publicades.</p>}
</div>

<style>
  .junta-llista { border-top: 2px solid var(--color-ink); }
  .temporada { border-bottom: 1px solid var(--color-rule); }
  .temporada summary {
    list-style: none; cursor: pointer;
    display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-lg);
    padding: var(--space-lg) var(--space-sm);
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .temporada summary::-webkit-details-marker { display: none; }
  .temporada summary:hover { background: var(--color-paper-2); }
  .temporada summary:focus-visible { outline-offset: -2px; }
  .temporada summary::after {
    content: ''; flex-shrink: 0; width: 8px; height: 8px; margin-left: auto;
    border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
    transform: rotate(45deg); transition: transform var(--dur-short) var(--ease-in-out);
  }
  .temporada[open] summary::after { transform: rotate(-135deg); }
  .numero { font-size: var(--text-2xl); color: var(--color-ink); }
  .comptador { font-size: var(--text-sm); color: var(--color-ink-2); }
  .membres {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); gap: var(--space-xl) var(--gap-columns);
    padding: var(--space-md) var(--space-sm) var(--space-2xl);
  }
  .foto { width: 100%; aspect-ratio: 1; border-radius: var(--radius-card); object-fit: cover; margin-bottom: var(--space-sm); }
  /* without a photo the person is text, under the colla's yellow, rather than a grey square */
  .persona.sense-foto { padding-top: var(--space-sm); border-top: 3px solid var(--color-signal); }
  .nom { font-weight: 600; }
  /* a malnom is a name, and the tree writes names in the display face */
  .malnom { font-family: var(--font-display); font-weight: var(--display-weight); color: var(--color-accent-deep); font-size: var(--text-lg); line-height: 1.2; margin-top: var(--space-3xs); }
  .carrec { font-size: var(--text-sm); color: var(--color-ink-2); margin-top: var(--space-2xs); }
  .empty { color: var(--color-ink-2); padding: 0 var(--space-sm) var(--space-lg); }
  @media (prefers-reduced-motion: reduce) { .temporada summary::after { transition: none; } }
</style>
