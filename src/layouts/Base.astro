---
import '../styles/global.css';
import '../styles/capcalera.css';
import { getEntry } from 'astro:content';
import { mediaUrl } from '../lib/media';
import { llegeixXarxes } from '../lib/xarxes';
import { carregaEstructura } from '../lib/carrega-estructura';
import NovaPestanya from '../components/NovaPestanya.astro';

interface Props {
  title: string;
  description?: string;
  showHeader?: boolean;
  heroImage?: string;
}

const { title, description, showHeader = true, heroImage } = Astro.props;
const base = import.meta.env.BASE_URL;
const config = await getEntry('configuracio', 'general');
const xarxes = llegeixXarxes(config?.data);
const bannerImage = heroImage ?? mediaUrl(base, config?.data.capceleraImatge);
const pageTitle = `${title} · Xoriguers UdG`;
const metaDescription = description ?? config?.data.descripcioGeneral;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = bannerImage ? new URL(bannerImage, Astro.site).toString() : undefined;
const escut = `${base}images/escut-xoriguers.png`;

// the bar, its dropdown, the phone menu and the footer all come from one list,
// the colla's (Configuració → Estructura del web; src/lib/estructura.ts), so
// they cannot drift apart. A page switched off, or empty like Notícies with
// every item a draft, is in none of them.
const { barra, colla, organitzacio, boto, peu, noms } = await carregaEstructura();
const ara = Astro.url.pathname.replace(/\/$/, '');
const actual = (href: string) => (href.replace(/\/$/, '') === ara ? 'page' : undefined);
const dinsDesplegable = [...colla, ...organitzacio].some((l) => actual(l.href));
---
<!doctype html>
<html lang="ca">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href={escut} />
  <link rel="apple-touch-icon" href={escut} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {/* the same two faces, at the same weights, as the arbre de xoriguers */}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@700;800&family=Figtree:wght@400;500;600;700&display=swap">
  <title>{pageTitle}</title>
  {metaDescription && <meta name="description" content={metaDescription} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Xoriguers UdG" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:url" content={canonicalUrl} />
  {metaDescription && <meta property="og:description" content={metaDescription} />}
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={pageTitle} />
  {metaDescription && <meta name="twitter:description" content={metaDescription} />}
</head>
<body>
  <a class="skip" href="#main">Salta al contingut</a>
  <header class="site-nav">
    <div class="container site-nav-inner">
      <a class="site-brand" href={base} aria-label="Xoriguers UdG, inici">
        <img class="site-brand-escut" src={escut} alt="" width="44" height="44" />
        <span class="display site-brand-name">Xoriguers</span>
        <span class="site-brand-tag">UdG</span>
      </a>
      <nav class="site-links" aria-label="Principal">
        {barra.map((p, i) =>
          p.tipus === 'enllac' ? (
            <a href={p.enllac.href} aria-current={actual(p.enllac.href)} target={p.enllac.extern ? '_blank' : undefined} rel={p.enllac.extern ? 'noreferrer' : undefined}>{p.enllac.text}{p.enllac.extern && <NovaPestanya />}</a>
          ) : (
            <details class={`nav-group${i === barra.length - 1 ? ' al-final' : ''}`}>
              <summary class={dinsDesplegable ? 'dins' : undefined}>{noms.desplegable}</summary>
              <div class={`nav-dropdown-panel${colla.length && organitzacio.length ? '' : ' una-col'}`}>
                {colla.length > 0 && (
                  <div class="nav-dropdown-col">
                    <span class="nav-dropdown-head">{noms.colla}</span>
                    {colla.map((l) => <a href={l.href} aria-current={actual(l.href)} target={l.extern ? '_blank' : undefined} rel={l.extern ? 'noreferrer' : undefined}>{l.text}{l.extern && <NovaPestanya />}</a>)}
                  </div>
                )}
                {organitzacio.length > 0 && (
                  <div class="nav-dropdown-col">
                    <span class="nav-dropdown-head">{noms.organitzacio}</span>
                    {organitzacio.map((l) => <a href={l.href} aria-current={actual(l.href)} target={l.extern ? '_blank' : undefined} rel={l.extern ? 'noreferrer' : undefined}>{l.text}{l.extern && <NovaPestanya />}</a>)}
                  </div>
                )}
              </div>
            </details>
          )
        )}
        {boto && <a class="nav-join" href={boto.barra.href} aria-current={actual(boto.barra.href)} target={boto.barra.extern ? '_blank' : undefined} rel={boto.barra.extern ? 'noreferrer' : undefined}>{boto.barra.text}{boto.barra.extern && <NovaPestanya />}</a>}
      </nav>
      {/* under 60rem the links above no longer fit on one line, so the same
          destinations fold into one menu */}
      <details class="nav-menu">
        <summary>Menú</summary>
        <nav class="nav-menu-panel" aria-label="Principal, mòbil">
          {boto && <a class="nav-join" href={boto.barra.href} target={boto.barra.extern ? '_blank' : undefined} rel={boto.barra.extern ? 'noreferrer' : undefined}>{boto.barra.text}{boto.barra.extern && <NovaPestanya />}</a>}
          {barra.map((p) => p.tipus === 'enllac' && (
            <a href={p.enllac.href} aria-current={actual(p.enllac.href)} target={p.enllac.extern ? '_blank' : undefined} rel={p.enllac.extern ? 'noreferrer' : undefined}>{p.enllac.text}{p.enllac.extern && <NovaPestanya />}</a>
          ))}
          {colla.length > 0 && <span class="nav-menu-head">{noms.colla}</span>}
          {colla.map((l) => <a href={l.href} aria-current={actual(l.href)} target={l.extern ? '_blank' : undefined} rel={l.extern ? 'noreferrer' : undefined}>{l.text}{l.extern && <NovaPestanya />}</a>)}
          {organitzacio.length > 0 && <span class="nav-menu-head">{noms.organitzacio}</span>}
          {organitzacio.map((l) => <a href={l.href} aria-current={actual(l.href)} target={l.extern ? '_blank' : undefined} rel={l.extern ? 'noreferrer' : undefined}>{l.text}{l.extern && <NovaPestanya />}</a>)}
        </nav>
      </details>
    </div>
  </header>

  {/* the page's title opens <main>, so «Salta al contingut» lands on it,
      and the page has one header landmark, the bar */}
  <main id="main">
    {showHeader && (
      <div class="page-hero">
        <div class={`page-hero-inner${bannerImage ? ' amb-foto' : ''}`}>
          <div class="page-hero-text">
            <h1 class="page-hero-title">{title}</h1>
          </div>
          {bannerImage && (
            <div class="page-hero-photo">
              <img src={bannerImage} alt="" width="1200" height="800" />
            </div>
          )}
        </div>
      </div>
    )}
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      {/* every page of the site is listed here, so nothing depends on finding a
          submenu to be reachable */}
      <nav class="footer-index" aria-label="Totes les pàgines">
        {([
          [noms.peuColla, peu.colla],
          [noms.peuCastells, peu.castells],
          [noms.peuOrganitzacio, peu.organitzacio],
        ] as const).map(([titol, enllacos]) => enllacos.length > 0 && (
          <div class="footer-col">
            <h2 class="footer-head">{titol}</h2>
            {enllacos.map((l) => <a href={l.href} target={l.extern ? '_blank' : undefined} rel={l.extern ? 'noreferrer' : undefined}>{l.text}{l.extern && <NovaPestanya />}</a>)}
          </div>
        ))}
        {(xarxes.length > 0 || peu.xarxes.length > 0) && (
          <div class="footer-col">
            <h2 class="footer-head">{noms.peuXarxes}</h2>
            {xarxes.map((x) => <a href={x.url} target="_blank" rel="noreferrer">{x.nom}<NovaPestanya /></a>)}
            {peu.xarxes.map((l) => <a href={l.href} target={l.extern ? '_blank' : undefined} rel={l.extern ? 'noreferrer' : undefined}>{l.text}{l.extern && <NovaPestanya />}</a>)}
          </div>
        )}
      </nav>
      <div class="footer-mast">
        <img class="footer-escut" src={escut} alt="" width="96" height="96" loading="lazy" data-arbre={`${base}arbre/`} />
        <div>
          <p class="footer-brand display" aria-hidden="true">Xoriguers UdG</p>
          <p class="footer-note">Colla castellera universitària de Girona, des de 1998</p>
        </div>
        {boto && <a class="btn btn-accent footer-join" href={boto.peu.href} target={boto.peu.extern ? '_blank' : undefined} rel={boto.peu.extern ? 'noreferrer' : undefined}>{boto.peu.text}{boto.peu.extern && <NovaPestanya />}</a>}
      </div>
    </div>
  </footer>

  {/* the dropdown and the phone menu are <details>, which open and close on
      their own but stay open otherwise: they close here with Escape (focus back
      on their button), on a click elsewhere, and when focus moves on out of
      them, so an open panel never sits over the page. Opening one closes the
      other. */}
  <script is:inline>
    (() => {
      const menus = [...document.querySelectorAll('details.nav-group, details.nav-menu')];
      const tanca = (menu, retornaFocus) => {
        if (!menu.open) return;
        menu.open = false;
        if (retornaFocus) menu.querySelector('summary').focus();
      };
      for (const menu of menus) {
        menu.addEventListener('toggle', () => {
          if (menu.open) for (const altre of menus) if (altre !== menu) altre.open = false;
        });
        menu.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menu.open) {
            e.preventDefault();
            tanca(menu, true);
          }
        });
        menu.addEventListener('focusout', (e) => {
          if (e.relatedTarget && !menu.contains(e.relatedTarget)) tanca(menu, false);
        });
      }
      document.addEventListener('click', (e) => {
        for (const menu of menus) if (!menu.contains(e.target)) tanca(menu, false);
      });
    })();
  </script>
  {/* a cross-origin map or calendar takes focus without ever matching :focus,
      so the frame is marked while it holds it, and the ring shows */}
  {/* the arbre de xoriguers is linked from nowhere: three taps in a row on the
      footer's escut open it, for those who know */}
  <script is:inline>
    (() => {
      const escut = document.querySelector('.footer-escut[data-arbre]');
      if (!escut) return;
      let cops = 0, darrer = 0;
      escut.addEventListener('click', () => {
        const ara = Date.now();
        cops = ara - darrer < 700 ? cops + 1 : 1;
        darrer = ara;
        if (cops < 3) return;
        cops = 0;
        const finestra = window.open(escut.dataset.arbre, '_blank');
        if (finestra) finestra.opener = null;
        else location.href = escut.dataset.arbre;
      });
    })();
  </script>
  <script is:inline>
    addEventListener('blur', () => setTimeout(() => {
      const a = document.activeElement;
      if (a && a.tagName === 'IFRAME') a.classList.add('te-focus');
    }));
    addEventListener('focus', () => document.querySelectorAll('iframe.te-focus').forEach((f) => f.classList.remove('te-focus')));
  </script>

  <style>
    html, body { overflow-x: clip; }
    .skip {
      position: absolute;
      left: var(--space-md);
      top: calc(-1 * var(--space-3xl));
      z-index: var(--z-toast);
      padding: var(--space-xs) var(--space-md);
      border-radius: var(--radius-input);
      background: var(--color-ink);
      color: var(--color-on-dark);
      font-weight: 600;
    }
    .skip:focus-visible { top: var(--space-md); }

    /* ---------- the bar: wordmark at one edge, the destinations at the other ---------- */
    .site-nav {
      position: sticky;
      top: 0;
      z-index: var(--z-sticky-nav);
      background: var(--color-paper);
      border-bottom: var(--rule-hair) solid var(--color-rule);
    }
    .site-nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-lg);
      min-height: 72px;
    }
    .site-brand {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      text-decoration: none;
      color: var(--color-ink);
      flex-shrink: 0;
    }
    .site-brand-escut { width: 44px; height: 44px; flex-shrink: 0; }
    .site-brand:hover { color: var(--color-ink); }
    .site-brand-name { font-size: var(--text-xl); line-height: 1; }
    .site-brand-tag {
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--color-accent-ink);
      background: var(--color-accent);
      border-radius: var(--space-xs);
      padding: var(--space-3xs) var(--space-xs);
    }

    .site-links { display: flex; align-items: center; gap: var(--space-lg); }
    .site-links > a,
    .nav-group summary {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2xs);
      min-height: 44px;
      font-size: var(--text-md);
      font-weight: 600;
      color: var(--color-ink);
      text-decoration: none;
      text-underline-offset: 0.35em;
      text-decoration-thickness: 2px;
      text-decoration-color: transparent;
      transition: color var(--dur-micro) var(--ease-out), text-decoration-color var(--dur-micro) var(--ease-out);
      cursor: pointer;
    }
    .site-links > a:hover,
    .nav-group summary:hover { color: var(--color-accent-deep); text-decoration-line: underline; text-decoration-color: var(--color-accent); }
    .site-links > a:active { opacity: 0.8; }
    /* where you are: the link underlined in the colla blue */
    .site-links > a[aria-current="page"]:not(.nav-join),
    .nav-group summary.dins { color: var(--color-accent-deep); text-decoration-line: underline; text-decoration-color: var(--color-accent); }

    /* Uneix-te is the site's one action, so it carries the yellow on every page */
    .site-links > .nav-join {
      padding: 0 var(--space-lg);
      background: var(--color-signal);
      color: var(--color-signal-ink);
      border-radius: var(--radius-pill);
      transition: background-color var(--dur-short) var(--ease-out);
    }
    .site-links > .nav-join:hover { background: color-mix(in oklab, var(--color-signal) 86%, var(--color-ink)); color: var(--color-signal-ink); text-decoration-line: none; }
    .site-links > .nav-join:focus-visible { outline-offset: 3px; }

    .nav-group { position: relative; }
    .nav-group summary { list-style: none; }
    .nav-group summary::-webkit-details-marker { display: none; }
    .nav-group summary::after {
      content: '';
      width: 6px;
      height: 6px;
      margin-left: var(--space-2xs);
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(45deg) translateY(-2px);
      transition: transform var(--dur-short) var(--ease-in-out);
    }
    .nav-group[open] summary::after { transform: rotate(-135deg) translateY(-1px); }
    .nav-dropdown-panel {
      position: absolute;
      top: calc(100% + var(--space-sm));
      left: calc(-1 * var(--space-sm));
      z-index: var(--z-dropdown);
      display: grid;
      grid-template-columns: repeat(2, minmax(12rem, 1fr));
      gap: var(--space-sm);
      padding: var(--space-sm);
      background: var(--color-paper);
      border: 1px solid var(--color-rule);
      border-top: 4px solid var(--color-signal);
      border-radius: var(--radius-card);
    }
    /* the colla can put the dropdown last in the bar, or leave one of its
       groups empty (Configuració → Estructura del web): it then opens towards
       the page, and with one column */
    .nav-group.al-final .nav-dropdown-panel { left: auto; right: calc(-1 * var(--space-sm)); }
    .nav-dropdown-panel.una-col { grid-template-columns: minmax(12rem, 1fr); }
    .nav-dropdown-col { display: flex; flex-direction: column; }
    .nav-dropdown-head {
      padding: var(--space-xs) var(--space-sm);
      font-size: var(--text-sm);
      font-weight: 600;
      color: var(--color-ink-2);
    }
    .nav-dropdown-panel a[aria-current="page"],
    .nav-menu-panel a[aria-current="page"] { background: var(--color-accent-wash); color: var(--color-accent-deep); font-weight: 600; }
    .nav-dropdown-panel a,
    .nav-menu-panel a {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      min-height: 44px;
      padding: 0 var(--space-sm);
      border-radius: var(--space-xs);
      font-size: var(--text-md);
      font-weight: 400;
      color: var(--color-ink);
      text-decoration: none;
      white-space: nowrap;
    }
    .nav-dropdown-panel a:hover,
    .nav-menu-panel a:hover { background: var(--color-paper-2); color: var(--color-accent-deep); }
    .nav-dropdown-panel a:active,
    .nav-menu-panel a:active { background: var(--color-paper-3); }

    /* ---------- the phone menu ---------- */
    .site-nav-inner { position: relative; }
    .nav-menu { display: none; }
    .nav-menu summary {
      list-style: none;
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 var(--space-md);
      border: 1px solid var(--color-ink);
      border-radius: var(--radius-pill);
      font-weight: 600;
      cursor: pointer;
    }
    .nav-menu summary::-webkit-details-marker { display: none; }
    .nav-menu summary:hover { background: var(--color-paper-2); }
    .nav-menu[open] summary { background: var(--color-ink); color: var(--color-on-dark); }
    .nav-menu-panel {
      position: absolute;
      right: var(--gutter);
      top: calc(100% - var(--space-xs));
      z-index: var(--z-dropdown);
      display: flex;
      flex-direction: column;
      width: min(20rem, calc(100% - 2 * var(--gutter)));
      max-height: calc(100dvh - 96px);
      overflow-y: auto;
      padding: var(--space-xs);
      background: var(--color-paper);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius-card);
    }
    .nav-menu-panel .nav-join { font-weight: 600; color: var(--color-accent-deep); }
    .nav-menu-head {
      margin: var(--space-xs) var(--space-sm) var(--space-2xs);
      padding-top: var(--space-xs);
      border-top: 1px solid var(--color-rule);
      font-size: var(--text-sm);
      color: var(--color-ink-2);
    }
    @media (max-width: 60rem) {
      .site-links { display: none; }
      .nav-menu { display: block; }
    }
    /* at 320px (a phone, or a laptop zoomed to 400%) the wordmark and the menu
       button did not fit side by side and the button ran off the edge: the
       wordmark tightens and drops its tag, which the link's name still says */
    @media (max-width: 24rem) {
      .site-nav-inner { gap: var(--space-sm); }
      .site-brand-tag { display: none; }
      .nav-menu summary { padding: 0 var(--space-sm); }
    }

    /* ---------- the footer: every page, then the name set large ---------- */
    .site-footer {
      background: var(--color-ink);
      color: var(--color-on-dark);
      padding-top: var(--space-3xl);
      padding-bottom: var(--space-xl);
      margin-top: var(--section-gap-s);
    }
    .site-footer :focus-visible { outline-color: var(--color-focus-on-dark); }
    .footer-index {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-xl) var(--gap-columns);
    }
    .footer-col { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2xs); }
    .footer-head {
      max-width: none;
      margin-bottom: var(--space-xs);
      font-family: var(--font-body);
      font-size: var(--text-sm);
      font-weight: 600;
      letter-spacing: 0;
      line-height: 1.4;
      color: var(--color-signal);
    }
    .footer-col a {
      display: inline-flex;
      align-items: center;
      min-height: 32px;
      font-size: var(--text-md);
      color: var(--color-on-dark);
      text-decoration: none;
    }
    .footer-col a:hover { color: var(--color-signal); text-decoration: underline; }
    .footer-mast {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-lg) var(--space-xl);
      margin-top: var(--space-3xl);
      padding-top: var(--space-xl);
      border-top: 1px solid var(--color-on-dark-rule);
    }
    /* three quick taps must not zoom the page or flash a highlight that gives it away */
    .footer-escut { width: 96px; height: 96px; touch-action: manipulation; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; -webkit-touch-callout: none; }
    .footer-join:focus-visible { outline-color: var(--color-focus-on-dark); }
    .footer-brand {
      font-size: clamp(3rem, 7vw, 5.25rem);
      line-height: 0.92;
      color: var(--color-on-dark);
      overflow-wrap: break-word;
      min-width: 0;
    }
    .footer-note {
      margin-top: var(--space-md);
      font-size: var(--text-sm);
      color: var(--color-on-dark-2);
    }
    @media (max-width: 60rem) {
      .footer-index { grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); }
      .footer-mast { grid-template-columns: auto minmax(0, 1fr); }
      .footer-join { grid-column: 1 / -1; justify-self: start; }
      .footer-escut { width: 64px; height: 64px; }
    }
  </style>
</body>
</html>
