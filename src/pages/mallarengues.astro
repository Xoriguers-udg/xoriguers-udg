---
import Base from '../layouts/Base.astro';
import { getEntry, getCollection, render } from 'astro:content';
import { mediaUrl } from '../lib/media';

const pagina = await getEntry('pagines', 'mallarengues');
const { Content } = await render(pagina!);
const base = import.meta.env.BASE_URL;
const imatge = mediaUrl(base, pagina?.data.imatge);

const protocols = (await getCollection('documents', ({ data }) => data.categoria === 'Protocol'));
---
<Base title={pagina!.data.titol ?? 'Mallarengues'} heroImage={imatge}>
  <div class="pagina">
    <div class="obertura">
    <div class="pagina-intro">
      <Content />
    </div>
    <aside class="costat">

    {protocols.length > 0 && (
      <dl class="dades costat-dades">
        {protocols.map((doc) => (
          <div class="dada">
            <dt class="dada-etiqueta">Protocol</dt>
            <dd class="dada-valor"><a href={mediaUrl(base, doc.data.fitxer)} target="_blank" rel="noreferrer">{doc.data.titol}</a></dd>
          </div>
        ))}
      </dl>
    )}
    <a class="btn btn-accent contacta" href={`${base}col-laboradors#contacte`}>Contacta’ns</a>
    </aside>
    </div>
  </div>
</Base>

<style>
  .dada-valor { margin-left: 0; overflow-wrap: anywhere; }
  .obertura { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-3xl); align-items: start; }
  .obertura .pagina-intro { margin-bottom: 0; }
  .costat { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-lg); padding: var(--space-xl); border-radius: var(--radius-card); background: var(--color-signal-wash); }
  .costat-dades { margin: 0; width: 100%; grid-template-columns: minmax(0, 1fr); }
  .costat .dada { padding: 0; background: none; }
  .costat .dada-etiqueta { color: var(--color-signal-text); }
  @media (max-width: 60rem) { .obertura { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); } }
</style>
