---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import { mediaUrl } from '../lib/media';
import MapEmbed from '../components/MapEmbed.astro';

const pagina = await getEntry('pagines', 'xorimusics');
const { Content } = await render(pagina!);
const uneixTe = await getEntry('pagines', 'uneix-te');
const base = import.meta.env.BASE_URL;
const imatge = mediaUrl(base, pagina?.data.imatge);
const partitures = pagina?.data.partitures ?? [];

// the músics block on Uneix-te is the one source for when and where they assagen
const assaigMusics = uneixTe?.data.assajos?.find((a) => a.clau === 'musics');
---
<Base title={pagina!.data.titol ?? 'Xorimúsics'} heroImage={imatge}>
  <div class="pagina">
    <div class="obertura">
      <div class="pagina-intro lead">
        <Content />
      </div>
      {(assaigMusics?.text || partitures.length === 0) && (
        <dl class="dades costat">
          {assaigMusics?.text && (
            <div class="dada">
              <dt class="dada-etiqueta">Assaig</dt>
              <dd class="dada-valor">{assaigMusics.text}</dd>
            </div>
          )}
          {/* until the first score is uploaded, the section is this one line */}
          {partitures.length === 0 && (
            <div class="dada">
              <dt class="dada-etiqueta">Partitures</dt>
              <dd class="dada-valor">Encara no n’hi ha cap de penjada.</dd>
            </div>
          )}
        </dl>
      )}
    </div>

    {partitures.length > 0 && (
    <section class="partitures" aria-labelledby="partitures-titol">
      <h2 id="partitures-titol">Partitures</h2>
      <p class="partitures-intro">Els tocs que fem a les diades, per estudiar-los a casa.</p>
        <ul class="files">
          {partitures.map((p) => (
            <li>
              <a class="fila partitura" href={mediaUrl(base, p.fitxer)} target="_blank" rel="noreferrer">
                <svg class="partitura-icona" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/></svg>
                <span class="fila-titol">{p.titol}</span>
                {p.instrument && <span class="pill pill-blue">{p.instrument}</span>}
                <span class="fila-meta partitura-obre">Obre el PDF<span class="visually-hidden"> (s’obre en una pestanya nova)</span></span>
              </a>
            </li>
          ))}
        </ul>
    </section>
    )}

    {assaigMusics?.ubicacio && (
      <section class="map-section" aria-labelledby="on-titol">
        <h2 id="on-titol">On assagem</h2>
        <MapEmbed ubicacio={assaigMusics.ubicacio} label="Ubicació dels assajos dels músics" />
      </section>
    )}
  </div>
</Base>

<style>
  .obertura { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-3xl); align-items: start; }
  .lead { margin-bottom: 0; }
  .dades.costat { margin-top: 0; grid-template-columns: minmax(0, 1fr); gap: var(--space-md); }
  .dada-valor { margin-left: 0; overflow-wrap: anywhere; }
  .partitures { margin-top: var(--section-gap-s); }
  .partitures h2 { font-size: var(--text-section); }
  .partitures-intro { margin: var(--space-sm) 0 var(--space-xl); color: var(--color-ink-2); }
  .partitura { grid-template-columns: auto minmax(0, 1fr) auto auto; }
  .partitura-icona { color: var(--color-accent); }
  .partitura-obre { font-weight: 600; color: var(--color-accent-deep); }
  @media (max-width: 40rem) {
    .partitura { grid-template-columns: auto minmax(0, 1fr); }
    .partitura .pill, .partitura-obre { grid-column: 2; justify-self: start; }
  }
  .map-section { margin-top: var(--section-gap-s); }
  .map-section h2 { margin-bottom: var(--space-xl); }
  @media (max-width: 60rem) { .obertura { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); } }
</style>
