---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { mediaUrl, isUploadedPath } from '../../lib/media';
import { formatDate } from '../../lib/format';
import { siApagada } from '../../lib/carrega-estructura';

// switched off in Configuració → Estructura del web: the address sends people home
const apagada = await siApagada('galeria', Astro.site);
if (apagada) return apagada;

const albums = await getCollection('galeria', ({ data }) => data.estat === 'publicat');
// an album is listed once it holds at least one uploaded photo: one still waiting
// for its pictures would only be an empty frame here
const sorted = albums
  .map((a) => ({ ...a, reals: a.data.fotos.filter(isUploadedPath) }))
  .filter((a) => a.reals.length > 0)
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime());

const base = import.meta.env.BASE_URL;
const capcalera = await getEntry('pagines', 'galeria');
const heroImage = mediaUrl(base, capcalera?.data.imatge);
const { Content: IntroContent } = await render(capcalera!);
---
<Base title="Àlbums" heroImage={heroImage}>
  <div class="pagina">
    {capcalera?.body?.trim() && (
      <div class="pagina-intro">
        <IntroContent />
      </div>
    )}
    {sorted.length > 0 ? (
      <ul class="grid">
        {sorted.map((album) => {
          const cover = mediaUrl(base, album.data.portada) ?? mediaUrl(base, album.reals[0]);
          return (
            <li>
              <a class="album" href={`${base}galeria/${album.id}`}>
                <div class="cover">
                  <img src={cover} alt="" width="800" height="600" loading="lazy" />
                </div>
                <h2 class="album-nom">{album.data.nom}</h2>
                <p class="meta"><time datetime={album.data.data.toISOString().slice(0, 10)}>{formatDate(album.data.data)}</time>, {album.reals.length} {album.reals.length === 1 ? 'fotografia' : 'fotografies'}</p>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="buit-text">Encara no hi ha cap àlbum.</p>
    )}
  </div>
</Base>

<style>
  .grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2xl) var(--gap-columns);
  }
  .album { display: block; color: var(--color-ink); text-decoration: none; }
  .cover {
    display: grid; place-items: center;
    aspect-ratio: 4 / 3; border-radius: var(--radius-card); overflow: hidden;
    background: var(--color-paper-3); color: var(--color-rule-firm);
  }
  .cover img { width: 100%; height: 100%; object-fit: cover; }
  .album-nom { margin-top: var(--space-md); font-size: var(--text-title); }
  .album:hover .album-nom { color: var(--color-accent-deep); text-decoration: underline; text-decoration-thickness: 2px; }
  .album:active { opacity: 0.85; }
  .album:focus-visible { outline-offset: 4px; border-radius: var(--radius-card); }
  .meta { margin-top: var(--space-2xs); font-size: var(--text-sm); color: var(--color-ink-2); }
  @media (max-width: 60rem) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 40rem) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
