---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { mediaUrl } from '../../lib/media';
import { formatDate } from '../../lib/format';
import { detallsEsdeveniment, llocComplet, temporadaDe } from '../../lib/esdeveniment';
import { llegeixCastellsRegistrats, notacioAmbEstat } from '../../lib/historial';
import { alHistorial, CLASSE_PILL, categoriaDe } from '../../lib/categories';
import { carregaCategories } from '../../lib/carrega-categories';
import { ancoraAgenda, ancoraHistorial, teFitxa } from '../../lib/fitxa';
import { paginaRedireccio } from '../../lib/redireccio';

export async function getStaticPaths() {
  const agenda = await getCollection('agenda', ({ data }) => data.estat === 'publicat');
  return agenda.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const categoria = categoriaDe(entry.data.tipus, (await carregaCategories()).categories);

// a past diada belongs to the historial; the agenda only lists what is still to
// come, so sending someone back there would be a dead end
const avui = new Date();
avui.setHours(0, 0, 0, 0);
const jaPassada = entry.data.data < avui;

// Every entry keeps its address, but only one with something more than its row
// has a page there (src/lib/fitxa.ts). The rest send the visitor to their row,
// so a link shared on WhatsApp, or the CMS's «Veure a la web», still lands.
const redireccio = teFitxa(entry)
  ? null
  : base +
    (jaPassada
      ? alHistorial(categoria, entry.data.castells.length) ? `castells#${ancoraHistorial(entry.id)}` : 'castells'
      : categoria.agenda ? `agenda#${ancoraAgenda(entry.id)}` : 'agenda');
if (redireccio) {
  return new Response(paginaRedireccio(redireccio, new URL(redireccio, Astro.site).href), {
    headers: { 'Content-Type': 'text/html; charset=utf-8' },
  });
}

const { Content } = await render(entry);

const pillClass = { descarregat: 'pill-moss', carregat: 'pill-gold', intent: 'pill-neutral' } as const;
const pillLabel = { descarregat: 'Descarregat', carregat: 'Carregat', intent: 'Intent' } as const;

const descripcio = [formatDate(entry.data.data), llocComplet(entry.data.lloc, entry.data.poblacio)]
  .filter(Boolean)
  .join(', ');
const lloc = detallsEsdeveniment(entry.data.hora, entry.data.lloc, entry.data.poblacio);

const temporada = temporadaDe(entry.data.data);
const castells = llegeixCastellsRegistrats(entry.data.castells);
// back to the very row this page opened from
const tornarA = jaPassada
  ? `${base}castells#${alHistorial(categoria, entry.data.castells.length) ? ancoraHistorial(entry.id) : `t-${temporada}`}`
  : `${base}agenda`;
const tornarText = jaPassada ? 'Historial de castells' : 'Agenda';
const ambFotos = entry.data.castells.some((c) => c.foto);
---
<Base title={entry.data.nom} description={descripcio} heroImage={mediaUrl(base, entry.data.cartell)} showHeader={false}>
  <div class="pagina">
    <a class="tornar back" href={tornarA}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>{tornarText}</a>
    <div class={`fitxa${mediaUrl(base, entry.data.cartell) ? ' amb-cartell' : ''}`}>
      <div class="fitxa-cos">
        <h1 class="fitxa-titol">{entry.data.nom}</h1>
        <div class="fitxa-meta">
          <time datetime={entry.data.data.toISOString().slice(0, 10)}>{formatDate(entry.data.data)}</time>
          {lloc && <span>{lloc}</span>}
        </div>
        <div class="etiquetes">
          <span class={`pill ${CLASSE_PILL[categoria.color]}`}>{categoria.nom}</span>
          {entry.data.cancelada && <span class="pill pill-danger">Cancel·lada</span>}
          <a class="pill pill-neutral temporada" href={`${base}castells#t-${temporada}`}>Temporada {temporada}</a>
        </div>
        {entry.data.collesParticipants.length > 0 && (
          <div class="chips">
            <span class="chips-etiqueta">Colles</span>
            {entry.data.collesParticipants.map((c: string) => <span class="chip">{c}</span>)}
          </div>
        )}
        <div class="body">
          <Content />
        </div>
        {entry.data.observacio && <p class="observacio">{entry.data.observacio}</p>}
      </div>
      {mediaUrl(base, entry.data.cartell) && <img class="cartell" src={mediaUrl(base, entry.data.cartell)} alt={`Cartell: ${entry.data.nom}`} width="600" height="800" />}
    </div>

    {entry.data.castells.length > 0 && (
      <section class="castells" aria-labelledby="castells-titol">
        <div class="castells-cap">
          <h2 id="castells-titol">Castells fets</h2>
          <span class="compte">{castells.length} {castells.length === 1 ? 'castell' : 'castells'}</span>
        </div>
        <ul class={`castells-row${ambFotos ? ' amb-fotos' : ''}`}>
          {entry.data.castells.map((c, i) => (
            <li class="castell">
              {mediaUrl(base, c.foto) ? (
                <img class="castell-foto" src={mediaUrl(base, c.foto)} alt={`El ${c.castell}`} width="900" height="1200" loading="lazy" />
              ) : ambFotos && (
                /* beside photographed castells, one without a photo keeps the same frame */
                <span class="castell-marc" aria-hidden="true"></span>
              )}
              <span class="notation display">{notacioAmbEstat(castells[i])}</span>
              <span class="castell-peu">
                <span class={`pill ${pillClass[c.estat]}`}>{pillLabel[c.estat]}</span>
                {c.ronda && <span class="ronda">Ronda {c.ronda}</span>}
              </span>
            </li>
          ))}
        </ul>
        {entry.data.notacioOriginal && (
          <p class="registre">
            Tal com es va escriure al registre: <span class="mono">{entry.data.notacioOriginal}</span>
          </p>
        )}
      </section>
    )}
  </div>
</Base>

<style>
  .fitxa { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-2xl); align-items: start; }
  .fitxa.amb-cartell { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .etiquetes { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-top: var(--space-lg); }
  .temporada { text-decoration: none; }
  .temporada:hover { background: var(--color-accent-wash); color: var(--color-accent-deep); }
  .chips { display: flex; gap: var(--space-xs); flex-wrap: wrap; align-items: center; margin-top: var(--space-lg); }
  .chips-etiqueta { font-size: var(--text-sm); color: var(--color-ink-2); margin-right: var(--space-2xs); }
  .chip { border: 1px solid var(--color-rule-firm); border-radius: var(--radius-pill); padding: var(--space-2xs) var(--space-sm); font-size: var(--text-sm); }
  .body { margin-top: var(--space-xl); font-size: var(--text-lead); line-height: 1.6; max-width: 60ch; }
  .body :global(p) { margin: 0 0 var(--space-md); }
  .observacio {
    margin-top: var(--space-lg); padding: var(--space-md) var(--space-lg);
    background: var(--color-signal-wash); color: var(--color-signal-text);
    border-radius: var(--radius-card); font-weight: 600; max-width: 60ch;
  }
  .cartell { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius-card); }

  .castells { margin-top: var(--section-gap-s); padding-top: var(--space-xl); border-top: 2px solid var(--color-ink); }
  .castells-cap { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-xs) var(--space-lg); }
  .castells h2 { text-wrap: balance; }
  .compte { font-family: var(--font-body); font-size: var(--text-lead); font-weight: 600; color: var(--color-ink-2); }
  .castells-row {
    list-style: none; margin: var(--space-xl) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: var(--gap-columns);
  }
  .castell { display: flex; flex-direction: column; gap: var(--space-xs); padding-top: var(--space-md); border-top: 1px solid var(--color-rule); }
  .castells-row.amb-fotos { grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); }
  .castell-marc { display: block; width: 100%; aspect-ratio: 3 / 4; border-radius: var(--radius-card); margin-bottom: var(--space-xs); background: var(--color-accent-wash); }
  .castell-foto { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius-card); margin-bottom: var(--space-xs); }
  .notation { font-size: var(--text-3xl); line-height: 1; overflow-wrap: anywhere; min-width: 0; }
  .castell-peu { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm); }
  .ronda { font-size: var(--text-sm); color: var(--color-ink-2); }
  .registre { margin-top: var(--space-xl); font-size: var(--text-sm); color: var(--color-ink-2); }
  @media (max-width: 60rem) {
    .fitxa.amb-cartell { grid-template-columns: minmax(0, 1fr); }
    .cartell { max-width: 26rem; }
  }
</style>
