---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { formatDate, formatDiaSetmana } from '../../lib/format';
import NovaPestanya from '../../components/NovaPestanya.astro';
import { mediaUrl } from '../../lib/media';
import { detallsEsdeveniment } from '../../lib/esdeveniment';
import { urlEmbedMensual, urlSubscripcioGoogle, urlSubscripcioWebcal } from '../../lib/calendari';
import { CLASSE_PILL, categoriaDe } from '../../lib/categories';
import { carregaCategories } from '../../lib/carrega-categories';
import { ancoraAgenda, teFitxa } from '../../lib/fitxa';
import { carregaEstructura, siApagada } from '../../lib/carrega-estructura';

// switched off in Configuració → Estructura del web: the address sends people home
const apagada = await siApagada('agenda', Astro.site);
if (apagada) return apagada;
const { enllac } = await carregaEstructura();

// only what is still to come, of the categories the colla lists here (Configuració
// → Calendari); everything past belongs to the historial
const { categories } = await carregaCategories();
const avui = new Date();
avui.setHours(0, 0, 0, 0);
const agenda = await getCollection(
  'agenda',
  ({ data }) => data.estat === 'publicat' && data.data >= avui && categoriaDe(data.tipus, categories).agenda
);
const sorted = agenda.sort((a, b) => a.data.data.getTime() - b.data.data.getTime());

const config = await getEntry('configuracio', 'general');
const embedUrl = urlEmbedMensual(config?.data.googleCalendarEmbedUrl);
const subscripcioGoogle = urlSubscripcioGoogle(config?.data.googleCalendarEmbedUrl);
const subscripcioWebcal = urlSubscripcioWebcal(config?.data.googleCalendarEmbedUrl);

const base = import.meta.env.BASE_URL;
const capcalera = await getEntry('pagines', 'agenda');
const heroImage = mediaUrl(base, capcalera?.data.imatge);
const { Content: IntroContent } = await render(capcalera!);
---
<Base title="Properes actuacions" heroImage={heroImage}>
  <div class="pagina">
    {capcalera?.body?.trim() && (
      <div class="pagina-intro">
        <IntroContent />
      </div>
    )}
    {sorted.length > 0 ? (
      <ol class="files">
        {sorted.map((entry, i) => {
          // a link only when the entry has a page of its own (src/lib/fitxa.ts):
          // an actuació from the calendar is all in its row already
          const Rengle = teFitxa(entry) ? 'a' : 'div';
          return (
          <li id={ancoraAgenda(entry.id)}>
            <Rengle class={`fila row${i === 0 ? ' propera' : ''}`} href={Rengle === 'a' ? `${base}agenda/${entry.id}` : undefined}>
              <div class="date">
                <span class="dia">{formatDiaSetmana(entry.data.data)}</span>
                <time datetime={entry.data.data.toISOString().slice(0, 10)}>{formatDate(entry.data.data)}</time>
              </div>
              <div class="info">
                <h2 class="fila-titol">{entry.data.nom}</h2>
                {detallsEsdeveniment(entry.data.hora, entry.data.lloc, entry.data.poblacio) && (
                  <div class="fila-meta">{detallsEsdeveniment(entry.data.hora, entry.data.lloc, entry.data.poblacio)}</div>
                )}
              </div>
              <div class="estats">
                {entry.data.cancelada && <span class="pill pill-danger">Cancel·lada</span>}
                {(() => {
                  const categoria = categoriaDe(entry.data.tipus, categories);
                  return <span class={`pill ${CLASSE_PILL[categoria.color]}`}>{categoria.nom}</span>;
                })()}
              </div>
            </Rengle>
          </li>
          );
        })}
      </ol>
    ) : (
      <p class="buit-text empty">
        No hi ha cap actuació programada ara mateix.{enllac('castells') && <> Les que ja s’han fet són a l’<a href={enllac('castells')}>historial de castells</a>.</>}
      </p>
    )}

    {/* only once the colla has set its calendar (Configuració → URL
        d’inserció de Google Calendar); until then the page simply has none */}
    {embedUrl && (
      <section class="calendari" aria-labelledby="calendari-titol">
        <h2 id="calendari-titol" class="section-title">Calendari</h2>
        {/* the month grid is Google's, and hard going with a keyboard or a
            screen reader: the same actuacions can go into your own calendar
            instead, where they keep themselves up to date */}
        <div class="subscriu">
          <p>Porta les actuacions al teu calendari: s’hi afegiran i s’actualitzaran soles.</p>
          <div class="subscriu-botons">
            {subscripcioGoogle && <a class="btn btn-outline" href={subscripcioGoogle} target="_blank" rel="noreferrer">Afegeix a Google Calendar<NovaPestanya /></a>}
            {subscripcioWebcal && <a class="btn btn-outline" href={subscripcioWebcal}>Afegeix a Apple, Outlook o un altre</a>}
          </div>
        </div>
        <iframe class="calendar-embed" src={embedUrl} loading="lazy" title="Calendari de la colla, per mesos"></iframe>
      </section>
    )}
  </div>
</Base>

<style>
  .fila { grid-template-columns: minmax(0, 3fr) minmax(0, 7fr) auto; }
  .date { display: flex; flex-direction: column; font-size: var(--text-md); font-weight: 600; color: var(--color-accent-deep); font-variant-numeric: tabular-nums; }
  .date .dia { font-size: var(--text-sm); font-weight: 500; color: var(--color-ink-2); }
  .info { display: flex; flex-direction: column; gap: var(--space-2xs); min-width: 0; }
  .estats { display: flex; flex-wrap: wrap; gap: var(--space-xs); justify-content: flex-end; }
  /* the one coming up next, the only thing on this page worth the yellow */
  .fila.propera { background: var(--color-signal-wash); }
  a.fila .fila-titol { color: var(--color-accent-deep); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  /* arriving from an old link to this entry (agenda#e-…) */
  li { scroll-margin-block: var(--space-3xl); }
  li:target .fila { box-shadow: inset 4px 0 0 var(--color-signal); }
  a.fila.propera:hover { background: color-mix(in oklab, var(--color-signal-wash) 85%, var(--color-signal)); }
  .empty { padding-block: var(--space-lg); border-block: 1px solid var(--color-rule); }

  .calendari { margin-top: var(--section-gap-s); }
  .section-title { margin-bottom: var(--space-xl); }
  /* a month grid needs six week-rows: at 600px each day was about 85px tall,
     which is what made the events unreadable */
  .calendar-embed {
    width: 100%; height: 820px; display: block;
    border: 1px solid var(--color-rule); border-radius: var(--radius-card);
    background: var(--color-paper);
  }
  .calendar-embed:focus, .calendari:focus-within .calendar-embed { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .subscriu { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-md) var(--space-xl); margin-bottom: var(--space-lg); }
  .subscriu p { max-width: 48ch; color: var(--color-ink-2); }
  .subscriu-botons { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  @media (max-width: 60rem) {
    .fila { grid-template-columns: minmax(0, 1fr); }
    .estats { justify-content: flex-start; }
    .calendar-embed { height: 620px; }
  }
</style>
