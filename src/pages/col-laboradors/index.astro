---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { mediaUrl } from '../../lib/media';
import { isRealUrl } from '../../lib/config';

const patrocinadors = (await getCollection('patrocinadors')).sort((a, b) => a.data.ordre - b.data.ordre);
const base = import.meta.env.BASE_URL;

const config = await getEntry('configuracio', 'general');
const comercialEmail = isRealUrl(config?.data.contacteComercialEmail) ? config!.data.contacteComercialEmail : undefined;
const laColla = await getEntry('pagines', 'la-colla');
const instagram = isRealUrl(laColla?.data.contacteInstagram) ? laColla!.data.contacteInstagram! : undefined;
const instagramUrl = isRealUrl(config?.data.instagramUrl)
  ? config!.data.instagramUrl
  : instagram && `https://instagram.com/${instagram.replace(/^@/, '')}`;

const contactePagina = await getEntry('pagines', 'col-laboradors');
const { Content: ContacteContent } = await render(contactePagina!);
const contacteImatge = mediaUrl(base, contactePagina?.data.imatge);

const introPagina = await getEntry('pagines', 'col-laboradors-intro');
const { Content: IntroContent } = await render(introPagina!);
---
<Base title="Col·laboradors" heroImage={contacteImatge}>
  <div class="pagina">
    {patrocinadors.length > 0 && introPagina?.body?.trim() && (
      <div class="pagina-intro">
        <IntroContent />
      </div>
    )}
    {patrocinadors.length > 0 && (
      <ul class="grid">
        {patrocinadors.map((p) => {
          const logo = mediaUrl(base, p.data.logo);
          const hasUrl = isRealUrl(p.data.url);
          const Tag = hasUrl ? 'a' : 'div';
          return (
            <li>
              <Tag class="card" href={hasUrl ? p.data.url : undefined} target={hasUrl ? '_blank' : undefined} rel={hasUrl ? 'noreferrer' : undefined}>
                {logo ? <img class="logo" src={logo} alt={p.data.nom} width="240" height="120" loading="lazy" /> : <span class="logo placeholder">{p.data.nom}</span>}
              </Tag>
            </li>
          );
        })}
      </ul>
    )}

    {(comercialEmail || instagramUrl) && (
      <section id="contacte" class={`contacte-comercial${patrocinadors.length > 0 ? '' : ' primera'}${contacteImatge ? '' : ' sense-foto'}`} aria-labelledby="comercial-titol">
        <div class="contacte-cos">
          <h2 id="comercial-titol">{contactePagina!.data.titol}</h2>
          <div class="contacte-text">
            <ContacteContent />
          </div>
          <div class="contacte-accions">
            {comercialEmail && <a class="btn btn-accent" href={`mailto:${comercialEmail}`}>Escriu-nos</a>}
            {instagramUrl && (
              <a class="btn btn-on-dark" href={instagramUrl} target="_blank" rel="noreferrer">
                Instagram<span class="visually-hidden"> (s’obre en una pestanya nova)</span>
              </a>
            )}
          </div>
          <dl class="email">
            {comercialEmail && (
              <div><dt>Correu</dt><dd><a href={`mailto:${comercialEmail}`}>{comercialEmail}</a></dd></div>
            )}
            {instagramUrl && (
              <div><dt>Instagram</dt><dd><a href={instagramUrl} target="_blank" rel="noreferrer">{instagram ?? instagramUrl}</a></dd></div>
            )}
          </dl>
        </div>
        {contacteImatge && <img class="contacte-imatge" src={contacteImatge} alt="" width="600" height="800" />}
      </section>
    )}
  </div>
</Base>

<style>
  .grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap-columns);
  }
  .card {
    display: flex; align-items: center; justify-content: center;
    min-height: 140px; padding: var(--space-lg);
    border-radius: var(--radius-card); background: var(--color-paper-2);
    text-decoration: none; transition: background-color var(--dur-short) var(--ease-out);
  }
  a.card:hover { background: var(--color-paper-3); }
  a.card:active { transform: translateY(1px); }
  .logo { max-width: 100%; max-height: 72px; object-fit: contain; }
  .logo.placeholder { font-weight: 600; color: var(--color-ink-2); text-align: center; }

  .contacte-comercial {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-3xl); align-items: center;
    margin-top: var(--section-gap-s);
    padding: var(--space-3xl) var(--space-2xl);
    border-radius: var(--radius-card);
    background: var(--color-ink); color: var(--color-on-dark);
  }
  .contacte-comercial :focus-visible { outline-color: var(--color-focus-on-dark); }
  .contacte-cos { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-lg); }
  .contacte-comercial h2 { color: var(--color-on-dark); overflow-wrap: break-word; min-width: 0; text-wrap: balance; }
  .contacte-text { color: var(--color-on-dark-2); max-width: 56ch; font-size: var(--text-lead); }
  .contacte-text :global(p) { margin: 0 0 var(--space-md); }
  .contacte-text :global(p:last-child) { margin-bottom: 0; }
  .contacte-imatge { width: 100%; aspect-ratio: 3 / 4; max-height: 480px; object-fit: cover; border-radius: var(--radius-card); }
  .contacte-comercial.primera { margin-top: 0; }
  .contacte-comercial.sense-foto { grid-template-columns: minmax(0, 1fr); }
  .contacte-accions { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  .btn-on-dark { background: transparent; border-color: var(--color-on-dark-rule); color: var(--color-on-dark); }
  .btn-on-dark:hover { background: color-mix(in oklab, var(--color-ink) 80%, var(--color-on-dark)); border-color: var(--color-on-dark); color: var(--color-on-dark); }
  .email { display: flex; flex-wrap: wrap; gap: var(--space-md) var(--space-2xl); margin: var(--space-xs) 0 0; font-size: var(--text-md); overflow-wrap: anywhere; }
  .email dt { font-size: var(--text-sm); font-weight: 600; color: var(--color-signal); }
  .email dd { margin: var(--space-3xs) 0 0; }
  .email a { color: var(--color-on-dark); }
  .email a:hover { color: var(--color-signal); }
  @media (max-width: 60rem) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .contacte-comercial { grid-template-columns: minmax(0, 1fr); padding: var(--space-2xl) var(--space-lg); gap: var(--space-xl); }
  }
</style>
