---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import { mediaUrl } from '../lib/media';

const pagina = await getEntry('pagines', 'arbre');
const { Content } = await render(pagina!);

const base = import.meta.env.BASE_URL;
const imatge = mediaUrl(base, pagina?.data.imatge);
// the tree is its own self-contained page under public/, framed rather than
// inlined: it carries page-wide styles for body and button that would otherwise
// fight with the site's. See docs/architecture.md.
const appUrl = `${base}arbre/app.html`;
---
<Base title={pagina!.data.titol ?? 'Arbre de xoriguers'} heroImage={imatge}>
  <div class="wrap">
    <div class="lead">
      <Content />
    </div>

    <div class="frame-wrap">
      <iframe
        class="arbre"
        src={appUrl}
        title="Arbre d'apadrinatge dels Xoriguers"
        loading="lazy"
      ></iframe>
    </div>

    {/* scrolling over the tree pans the tree, so on a phone there has to be a
        way out of it — and the app is a perfectly good page on its own */}
    <div class="sota">
      <a class="btn btn-outline" href={appUrl} target="_blank" rel="noreferrer">
        Obre l'arbre a pantalla completa
      </a>
      <p class="nota">
        L'arbre es mou arrossegant-lo. Si et quedes encallat al mòbil, fes servir
        el botó per obrir-lo sol.
      </p>
    </div>
  </div>
</Base>

<style>
  .wrap { max-width: var(--ample); margin: 0 auto; padding: 40px 28px 60px; }
  .lead {
    font-size: 1.0625rem; line-height: 1.65; color: var(--ink-soft);
    max-width: 62ch; margin-bottom: 26px;
  }
  .lead :global(p) { margin: 0 0 14px; }
  .lead :global(p:last-child) { margin-bottom: 0; }

  /* the app paints its own white ground, so the frame only has to give it an
     edge that matches every other panel on the site */
  .frame-wrap {
    border: 1px solid var(--line);
    border-top: 3px solid var(--blue);
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
  }
  /* deliberately short of the viewport: there is always page left to scroll
     with above and below the tree */
  .arbre {
    display: block;
    width: 100%;
    height: 78vh;
    min-height: 460px;
    max-height: 760px;
    border: 0;
  }

  .sota {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px;
    margin-top: 18px;
  }
  .nota { margin: 0; font-size: 0.8125rem; color: var(--ink-soft); max-width: 48ch; }

  @media (max-width: 720px) {
    .arbre { height: 70vh; min-height: 380px; }
  }
</style>
