---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { mediaUrl } from '../../lib/media';

const documents = await getCollection('documents');
const base = import.meta.env.BASE_URL;
const capcalera = await getEntry('pagines', 'documents');
const heroImage = mediaUrl(base, capcalera?.data.imatge);
const { Content: IntroContent } = await render(capcalera!);

const categories = ['Estatuts', 'Reglament', 'Protocol', 'Altres'] as const;
const grups = categories.map((cat) => ({
  categoria: cat,
  documents: documents.filter((d) => d.data.categoria === cat),
}));
---
<Base title="Documents" heroImage={heroImage}>
  <div class="pagina">
    {capcalera?.body?.trim() && (
      <div class="pagina-intro">
        <IntroContent />
      </div>
    )}

    <div class="grups">
      {grups.map((grup) => grup.documents.length > 0 && (
        <section class="grup">
          <h2 class="grup-titol">{grup.categoria}</h2>
          <ul class="files">
            {grup.documents.map((d) => (
              <li>
                <a class="fila doc" href={mediaUrl(base, d.data.fitxer)} target="_blank" rel="noreferrer">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="1"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="13" y2="16"/></svg>
                  <span class="doc-titol">{d.data.titol}</span>
                  <span class="doc-obre">Obre el PDF<span class="visually-hidden"> (s’obre en una pestanya nova)</span></span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    {documents.length === 0 && <p class="buit-text">Encara no hi ha documents publicats.</p>}
  </div>
</Base>

<style>
  .grups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2xl) var(--gap-columns); }
  .grup-titol { font-size: var(--text-xl); margin-bottom: var(--space-md); }
  .doc { grid-template-columns: auto minmax(0, 1fr) auto; gap: var(--space-md); padding-block: var(--space-md); }
  .doc svg { flex-shrink: 0; color: var(--color-accent); }
  .doc-titol { font-weight: 600; font-size: var(--text-lg); overflow-wrap: break-word; min-width: 0; }
  .doc-obre { font-size: var(--text-sm); color: var(--color-ink-2); white-space: nowrap; }
  a.doc:hover .doc-titol { color: var(--color-accent-deep); }
  @media (max-width: 60rem) { .grups { grid-template-columns: minmax(0, 1fr); } }
</style>
