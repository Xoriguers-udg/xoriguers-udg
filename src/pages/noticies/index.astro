---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { mediaUrl } from '../../lib/media';
import { formatDate } from '../../lib/format';
import { siApagada } from '../../lib/carrega-estructura';

// switched off in Configuració → Estructura del web: the address sends people home
const apagada = await siApagada('noticies', Astro.site);
if (apagada) return apagada;

const noticies = await getCollection('noticies', ({ data }) => data.estat === 'publicat');
const sorted = noticies.sort((a, b) => b.data.data.getTime() - a.data.data.getTime());

const base = import.meta.env.BASE_URL;
const capcalera = await getEntry('pagines', 'noticies');
const heroImage = mediaUrl(base, capcalera?.data.imatge);
const { Content: IntroContent } = await render(capcalera!);
---
<Base title="Últimes notícies" heroImage={heroImage}>
  <div class="pagina">
    {capcalera?.body?.trim() && (
      <div class="pagina-intro">
        <IntroContent />
      </div>
    )}
    {sorted.length > 0 ? (
      <ul class="files">
        {sorted.map((n) => (
          <li>
            <a class={`fila row${mediaUrl(base, n.data.imatge) ? '' : ' sense-foto'}`} href={`${base}noticies/${n.id}`}>
              <time class="date" datetime={n.data.data.toISOString().slice(0, 10)}>{formatDate(n.data.data)}</time>
              <div class="info">
                <h2 class="fila-titol">{n.data.titol}</h2>
                <p class="resum">{n.data.resum}</p>
              </div>
              {mediaUrl(base, n.data.imatge) && <img class="thumb" src={mediaUrl(base, n.data.imatge)} alt="" width="200" height="150" loading="lazy" />}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="buit-text">Encara no hi ha cap notícia publicada.</p>
    )}
  </div>
</Base>

<style>
  .fila { grid-template-columns: minmax(0, 2fr) minmax(0, 8fr) minmax(0, 2fr); }
  .fila.sense-foto .info { grid-column: 2 / -1; }
  .date { font-size: var(--text-sm); color: var(--color-ink-2); font-variant-numeric: tabular-nums; }
  .info { display: flex; flex-direction: column; gap: var(--space-xs); min-width: 0; }
  .resum { color: var(--color-ink-2); max-width: 65ch; }
  .thumb { justify-self: end; width: 100%; max-width: 200px; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--space-xs); }
  @media (max-width: 60rem) {
    .fila { grid-template-columns: minmax(0, 1fr) 96px; }
    .date { grid-column: 1 / -1; }
    .fila.sense-foto .info { grid-column: 1 / -1; }
  }
</style>
