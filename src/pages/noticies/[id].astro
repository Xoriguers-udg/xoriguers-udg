---
import Base from '../../layouts/Base.astro';
import '../../styles/pagines/noticia.css';
import { getCollection, render } from 'astro:content';
import { mediaUrl } from '../../lib/media';
import { formatDate } from '../../lib/format';
import { paginaActiva } from '../../lib/carrega-estructura';

export async function getStaticPaths() {
  // switched off in Configuració → Estructura del web: none of them is built
  if (!(await paginaActiva('noticies'))) return [];
  const noticies = await getCollection('noticies', ({ data }) => data.estat === 'publicat');
  return noticies.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const base = import.meta.env.BASE_URL;
---
<Base title={entry.data.titol} description={entry.data.resum} heroImage={mediaUrl(base, entry.data.imatge)} showHeader={false}>
  <article class="pagina estreta pg-noticia">
    <a class="tornar back" href={`${base}noticies`}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>Notícies</a>
    <h1 class="fitxa-titol">{entry.data.titol}</h1>
    <p class="fitxa-meta"><time datetime={entry.data.data.toISOString().slice(0, 10)}>{formatDate(entry.data.data)}</time></p>
    {mediaUrl(base, entry.data.imatge) && <img class="hero-img" src={mediaUrl(base, entry.data.imatge)} alt="" width="1200" height="675" />}
    <div class="body">
      <Content />
    </div>
  </article>
</Base>

