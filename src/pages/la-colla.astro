---
import Base from '../layouts/Base.astro';
import MillorsCastells from '../components/MillorsCastells.astro';
import { getEntry, render } from 'astro:content';
import { mediaUrl } from '../lib/media';
import { isRealUrl } from '../lib/config';
import { carregaEstructura, siApagada } from '../lib/carrega-estructura';

// switched off in Configuració → Estructura del web: the address sends people home
const apagada = await siApagada('la-colla', Astro.site);
if (apagada) return apagada;
const { enllac } = await carregaEstructura();

const pagina = await getEntry('pagines', 'la-colla');
const { Content } = await render(pagina);
const base = import.meta.env.BASE_URL;
const imatge = mediaUrl(base, pagina.data.imatge);
const fotoColla = mediaUrl(base, pagina.data.fotoColla);

// the assaig blocks on Uneix-te are the one place the schedule is written, so
// this page shows them rather than keeping a second copy that can drift
const uneixTe = await getEntry('pagines', 'uneix-te');
const assajos = (uneixTe?.data.assajos ?? []).filter((a) => a.text);

// the colla's other pages, each only while it is switched on
const mesColla = [
  { clau: 'xorimusics', nom: 'Xorimúsics', que: 'Gralles i tabals' },
  { clau: 'mallarengues', nom: 'Mallarengues', que: 'Igualtat i diversitat' },
  { clau: 'junta-tecnica', nom: 'Junta tècnica', que: 'Els tècnics de la temporada' },
  { clau: 'junta-directiva', nom: 'Junta directiva', que: 'La directiva de la temporada' },
] as const;
const mesCollaActius = mesColla.flatMap((m) => (enllac(m.clau) ? [{ ...m, href: enllac(m.clau)! }] : []));
---
<Base title={pagina.data.titol ?? 'La colla'} heroImage={imatge}>
  <div class="pagina">
    <div class="obertura">
      {/* the editor writes one text; its first paragraph opens the page and the
          rest follows the photo. Each half is the same render with the other
          half hidden, so any markdown in it keeps working */}
      <div class="pagina-intro text-colla primer">
        <Content />
      </div>
      <aside class="costat">
        {mesCollaActius.length > 0 && (
          <nav class="mes-colla" aria-label="Més de la colla">
            {mesCollaActius.map((m) => <a href={m.href}><span class="display">{m.nom}</span><span>{m.que}</span></a>)}
          </nav>
        )}
      </aside>
    </div>
  </div>

  {fotoColla && (
    <figure class="foto-colla">
      <img src={fotoColla} alt="Tota la colla, amb la camisa blava, asseguda i dreta sota una volta gòtica" width="1600" height="2133" loading="lazy" />
    </figure>
  )}

  <div class="pagina">
    <div class="text-colla resta">
      <Content />
    </div>

    <MillorsCastells />

    <section class="assajar" aria-labelledby="assajar-titol">
      <h2 id="assajar-titol">On i quan assagem</h2>
      <dl class="dades">
        {assajos.map((assaig) => (
          <div class="dada">
            <dt class="dada-etiqueta">{assaig.titol}</dt>
            <dd class="dada-valor">{assaig.text}</dd>
          </div>
        ))}
        <div class="dada">
          <dt class="dada-etiqueta">Contacte</dt>
          <dd class="dada-valor">
            {isRealUrl(pagina.data.contacteInstagram) && (
              <a class="contacte" href={`https://instagram.com/${pagina.data.contacteInstagram!.replace(/^@/, '')}`} target="_blank" rel="noreferrer">{pagina.data.contacteInstagram}</a>
            )}
            {enllac('col-laboradors') && <a class="contacte" href={`${enllac('col-laboradors')}#contacte`}>Contacta’ns</a>}
          </dd>
        </div>
      </dl>
      {enllac('uneix-te') && <a class="btn btn-accent mes" href={enllac('uneix-te')}>Com venir a assajar</a>}
    </section>
  </div>
</Base>

<style>
  .obertura { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-3xl); align-items: start; }
  .text-colla { margin-bottom: 0; }
  /* the first paragraph is who we are; it is set a size up from the rest */
  .primer :global(> :not(:first-child)) { display: none; }
  .primer :global(> :first-child) { font-size: clamp(1.375rem, 1vw + 1rem, 1.875rem); line-height: 1.35; color: var(--color-ink); margin: 0; }
  .resta { columns: 2 22rem; column-gap: var(--space-3xl); margin-top: var(--space-2xl); font-size: var(--text-lead); line-height: 1.55; color: var(--color-ink-2); }
  .resta :global(> :first-child) { display: none; }
  .resta :global(p) { margin: 0 0 var(--space-md); break-inside: avoid; max-width: none; }
  .costat { display: flex; flex-direction: column; gap: var(--space-xl); }

  .mes-colla { display: flex; flex-direction: column; border-top: 2px solid var(--color-ink); }
  .mes-colla a {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-md) var(--space-sm);
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink);
    text-decoration: none;
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .mes-colla a:hover { background: var(--color-paper-2); }
  .mes-colla a:hover .display { color: var(--color-accent-deep); }
  .mes-colla a:active { background: var(--color-paper-3); }
  .mes-colla a:focus-visible { outline-offset: -2px; }
  .mes-colla .display { font-size: var(--text-xl); line-height: 1.1; }
  .mes-colla span:last-child { font-size: var(--text-sm); color: var(--color-ink-2); }

  /* the whole colla, the width of the window: the photo is cropped to the people */
  .foto-colla { margin: var(--section-gap-s) 0 0; background: var(--color-accent-deep); }
  .foto-colla img {
    display: block;
    width: 100%;
    height: clamp(300px, 42vw, 620px);
    object-fit: cover;
    object-position: 50% 68%;
  }

  .assajar { margin-top: var(--section-gap-s); }
  .assajar h2 { font-size: var(--text-section); }
  .assajar .dades { margin-top: var(--space-xl); }
  .dada-valor { margin-left: 0; }
  .contacte { display: block; overflow-wrap: anywhere; }
  .mes { margin-top: var(--space-xl); }
  @media (max-width: 60rem) { .obertura { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); } }
</style>
